<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global Industrial ESP32 HMI</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            background-color: #0b0e14; 
            color: #e5e7eb; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            padding: 20px;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #151d2a;
            padding: 16px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            border: 1px solid #263347;
        }
        .title { font-size: 16px; font-weight: 700; color: #ffffff; letter-spacing: 0.5px; }
        .status-badge {
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }
        .online { background: #064e3b; color: #34d399; }
        .offline { background: #7f1d1d; color: #f87171; }
        
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .card {
            background: #151d2a;
            border: 1px solid #263347;
            border-radius: 8px;
            padding: 24px;
        }
        .label { font-size: 12px; color: #9ca3af; text-transform: uppercase; letter-spacing: 1px; }
        .val { font-size: 64px; font-weight: 800; font-family: monospace; margin: 10px 0; }
        .temp { color: #f97316; }
        .humid { color: #38bdf8; }
        .unit { font-size: 24px; color: #6b7280; }
        .footer-note { font-size: 11px; color: #6b7280; margin-top: 8px; }
    </style>
    <!-- Paho MQTT WebSockets Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.0.1/mqttws31.min.js"></script>
</head>
<body>

    <div class="header">
        <div class="title">REMOTE INDUSTRIAL HMI &mdash; LONG DISTANCE LINK</div>
        <div id="status" class="status-badge offline">DISCONNECTED</div>
    </div>

    <div class="grid">
        <div class="card">
            <div class="label">Remote Temperature</div>
            <div class="val temp"><span id="temp-val">--.-</span><span class="unit">°C</span></div>
            <div class="footer-note">Cloud Stream: broker.hivemq.com</div>
        </div>
        <div class="card">
            <div class="label">Remote Humidity</div>
            <div class="val humid"><span id="humid-val">--</span><span class="unit">%</span></div>
            <div class="footer-note">Topic: myfactory/esp32/telemetry</div>
        </div>
    </div>

    <script>
        // Unique MQTT Topic Key to prevent collision with other public users
        const MQTT_TOPIC = "myfactory/pwr_remote/telemetry"; 
        const statusBadge = document.getElementById('status');

        // Connect to HiveMQ Public Broker over secure WebSockets
        const clientID = "web_hmi_" + Math.random().toString(16).substr(2, 8);
        const client = new Paho.MQTT.Client("broker.hivemq.com", 8000, clientID);

        client.onConnectionLost = (responseObject) => {
            statusBadge.innerText = "CLOUD LINK OFFLINE";
            statusBadge.className = "status-badge offline";
            setTimeout(connectMQTT, 3000); // Auto-reconnect
        };

        client.onMessageArrived = (message) => {
            try {
                const data = JSON.parse(message.payloadString);
                document.getElementById('temp-val').innerText = data.temperature.toFixed(1);
                document.getElementById('humid-val').innerText = data.humidity;
            } catch (e) {
                console.error("Payload error:", e);
            }
        };

        function connectMQTT() {
            statusBadge.innerText = "CONNECTING TO CLOUD...";
            client.connect({
                onSuccess: () => {
                    statusBadge.innerText = "GLOBAL CLOUD ONLINE";
                    statusBadge.className = "status-badge online";
                    client.subscribe(MQTT_TOPIC);
                },
                onFailure: (err) => {
                    statusBadge.innerText = "CONNECTION FAILED";
                    statusBadge.className = "status-badge offline";
                    setTimeout(connectMQTT, 5000);
                }
            });
        }

        connectMQTT();
    </script>
</body>
</html>
